{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/context.py\" session",
            "timeout": 5,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/context.py\" subagent",
            "timeout": 5,
            "additionalContextLimit": 1000
          }
        ]
      }
    ]
  }
}
